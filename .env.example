# Copy to .env, fill with AUTHORIZED LOCAL paths, and never commit the result.
# All paths must point outside version control. No real values appear here.

# Directory containing the authorized restricted project workspace
# (cleaned_data/, derived_data/, modeling_results*/, protocol YAML files, ...).
RA_PROJECT_DIR=/path/to/authorized/project

# Exact restricted source CSV supplied by the data owner.
RA_DATA_PATH=/path/to/authorized/restricted_source.csv

# Local output directory for generated tables, figures and reports.
RA_OUTPUT_DIR=/path/to/local/outputs

# Local directory for model packages, SHAP exports and other derived artifacts.
RA_ARTIFACT_DIR=/path/to/local/artifacts

# Authorized local JSON list of individual value corrections (identifiers and
# original/cleaned values). Schema only: config/corrections_template.json.
RA_CORRECTIONS_PATH=/path/to/authorized/corrections.json

# Optional: explicit project root inside a Colab runtime.
# RA_PROJECT_DIR=/content/drive/MyDrive/<authorized-project>

# Optional software-only smoke-test switches. NEVER use for scientific results.
# RA_STAGE2_EXPORT_MODE=1
# RA_STAGE3A_EXPORT_MODE=1
# RA_STAGE3B_QUICK_TEST=1
# RA_STAGE3B_EXPORT_MODE=1
# RA_STAGE3C_QUICK_TEST=1
# RA_STAGE4_QUICK_TEST=1
# RA_STAGE4M_QUICK_TEST=1
# RA_STAGE4G_QUICK_TEST=1

# Load in a notebook or shell before execution, e.g.:
#   set -a; source .env; set +a
# The repository never downloads, generates or fabricates clinical data.
